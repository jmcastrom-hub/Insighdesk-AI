# Copia este archivo como .env y configura una clave nueva después de revocar la anterior.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set a strong, private manager password and separate random session secret.
MANAGER_PASSWORD=
APP_AUTH_SECRET=
# Demo seller accounts are created only when this value is configured.
DEMO_SELLER_PASSWORD=
# Obtain a bearer token from the BCCR SDDE service; never commit it.
BCCR_API_TOKEN=
BCCR_USD_BUY_INDICATOR=317
BCCR_EUR_USD_INDICATOR=333
